# Copy this file to .env, then replace every value.

# PostgreSQL (one database per service is created automatically)
POSTGRES_USER=learnu
POSTGRES_PASSWORD=change-me

# Django secret key, used by the Django services
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Shared by the auth service (signs the tokens) and the API gateway (checks them).
# At least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-min

# Public URLs (defaults are fine on your own machine)
# FRONTEND_URL=http://localhost:5173
# GATEWAY_PUBLIC_URL=http://localhost:8083
